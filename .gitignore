# Local docs: track wip/ (public-safe drafts) and archive/ (retired drafts). Everything else under .docs/ stays local - notably .docs/private/ for work material that must not be published.
.docs/*
!.docs/wip/
!.docs/archive/

*.gem

# Ignore metadata generated by Jekyll
build/
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler

.bundle
.bundle/
vendor/
# Python caches from the devblog skill tests
__pycache__/
.pytest_cache/
